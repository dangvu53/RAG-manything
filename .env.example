# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QWEN_QDRANT_COLLECTION=virhe4qa_qwen_api_30_fdd19f

# Retrieval embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_FP16=false

# Locally hosted OpenAI-compatible answer model
ANSWER_BASE_URL=http://localhost:8000/v1
ANSWER_API_KEY=local
ANSWER_MODEL=Qwen/Qwen3-4B

# Kaggle-hosted Qwen embedding and answer API; use the current ngrok URL
RAG_API_URL=
RAG_API_KEY=

# Qwen API on Kaggle
QWEN_API_URL=https://<tunnel-domain>/generate
QWEN_API_TOKEN=
QWEN_MODEL=Qwen/Qwen3-4B
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_RETRIES=2
QWEN_MAX_NEW_TOKENS=1024
QWEN_TEMPERATURE=0.1

# OpenAI guardrails and evaluation
OPENAI_API_KEY=
OPENAI_INPUT_GUARDRAIL_MODEL=gpt-4o-mini
OPENAI_OUTPUT_GUARDRAIL_MODEL=gpt-5-mini
OPENAI_EVAL_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

INPUT_GUARDRAIL_ENABLED=true
OUTPUT_GUARDRAIL_ENABLED=true
MAX_QUESTION_CHARS=4000
MAX_CONTEXT_CHARS=16000

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-manything-prompt-answer
