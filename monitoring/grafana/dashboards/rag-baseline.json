{
  "uid": "rag-baseline",
  "title": "RAG-manything BM25 baseline",
  "tags": ["rag", "bm25"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum by (status) (rate(rag_http_requests_total{endpoint=\"/v1/answer\"}[5m]))", "legendFormat": "{{status}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 / p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(rag_http_request_duration_seconds_bucket{endpoint=\"/v1/answer\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_http_request_duration_seconds_bucket{endpoint=\"/v1/answer\"}[5m])))", "legendFormat": "p95", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pipeline stage latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(rag_stage_duration_seconds_bucket[5m])))", "legendFormat": "{{stage}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latest BM25 retrieval quality",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rag_evaluation_score{suite=\"retrieval\",metric=\"Recall\",cutoff=\"10\"}", "legendFormat": "Recall@10", "refId": "A" },
        { "expr": "rag_evaluation_score{suite=\"retrieval\",metric=\"nDCG\",cutoff=\"10\"}", "legendFormat": "nDCG@10", "refId": "B" },
        { "expr": "rag_evaluation_score{suite=\"retrieval\",metric=\"MRR\",cutoff=\"10\"}", "legendFormat": "MRR@10", "refId": "C" },
        { "expr": "rag_evaluation_score{suite=\"retrieval\",metric=\"Precision\",cutoff=\"10\"}", "legendFormat": "Precision@10", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latest answer quality scores",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "rag_evaluation_score{suite=\"answer\"}", "legendFormat": "{{metric}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latest answer evaluation latency p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "rag_evaluation_latency_seconds{statistic=\"p95\"}", "legendFormat": "p95", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "value", "colorMode": "value", "graphMode": "area", "justifyMode": "auto" }
    }
  ]
}
